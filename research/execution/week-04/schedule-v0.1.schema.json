{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanilladb.org/mit/schema/vc-schedule-0.1.json",
  "title": "VanillaCore MIT Schedule DSL v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "scheduleId",
    "family",
    "source",
    "versions",
    "seed",
    "timeoutMillis",
    "policy",
    "operations",
    "observations",
    "strictOrder",
    "happensBefore",
    "expectedOutcome",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {"const": "vc-schedule-0.1"},
    "scheduleId": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "timeoutMillis": {"type": "integer", "minimum": 1},
    "operations": {"type": "array"},
    "observations": {"type": "array", "minItems": 1},
    "strictOrder": {"type": "array", "minItems": 1, "uniqueItems": true},
    "happensBefore": {"type": "array"}
  },
  "additionalProperties": true
}
